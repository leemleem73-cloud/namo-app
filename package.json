{
  "name": "namo-app",
  "version": "1.0.0",
  "description": "Namo Chemical QMS",
  "main": "server.js",
  "scripts": {
    "start": "node startup-maintenance.js && node -r ./security-bootstrap.js -r ./inventory-server.js -r ./inventory-force-install.js -r ./qmes-extra-sync-server.js server.js",
    "start:dev": "QMES_ENV=development node -r ./dev-environment-bootstrap.js -r ./security-bootstrap.js -r ./inventory-server.js -r ./inventory-force-install.js -r ./qmes-extra-sync-server.js server.js",
    "start:staging": "QMES_ENV=staging node -r ./dev-environment-bootstrap.js -r ./security-bootstrap.js -r ./inventory-server.js -r ./inventory-force-install.js -r ./qmes-extra-sync-server.js server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.0"
  }
}
