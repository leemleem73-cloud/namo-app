# Application
TZ=Asia/Seoul
PORT=3000

# PostgreSQL
DATABASE_URL=

# Session security: set a long random value in the private .env file
SESSION_SECRET=

# Initial administrator account
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Attendance direct email (ECOUNT)
SMTP_HOST=wsmtp.ecount.com
SMTP_PORT=587
SMTP_SECURE=false
# Optional: separate encryption key for per-user linked mail credentials.
# If empty, SESSION_SECRET is used.
MAIL_CREDENTIAL_KEY=
